
@{
    ViewBag.Title = "Imprimir";
}

<h2>Imprimir</h2>


<body>
    <div class="container mt-5">
        <div class="card">
            <div class="card-header text-center bg-danger text-white">
                <h3>Lista PDF</h3>
            </div>
            <div class="card-body text-center">
                <h4>Elige un salón</h4>
                <form action="ImprimirPDF" method="post">
                    <select class="form-select mt-3" id="salonSeleccionadoIm" name="salonSeleccionadoIm">
                        <option value="">Selecciona un salón</option>
                        @if (ViewBag.Salones != null)
                        {
                            foreach (var item in ViewBag.Salones)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        }
                    </select>

                    <select class="form-select mt-3" id="FechaSeleccionadoIm" name="FechaSeleccionadoIm">
                        <option value="@DateTime.Now.ToString("yyyy/MM/dd")">@DateTime.Now.ToString("yyyy/MM/dd")</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            for (int j = 1; j <= DateTime.DaysInMonth(DateTime.Now.Year, i); j++)
                            {
                                DateTime date = new DateTime(DateTime.Now.Year, i, j);
                                <option value="@date.ToString("yyyy-MM-dd")">@date.ToString("dd/MM/yyyy")</option>
                            }
                        }
                    </select>



                    <button class="btn btn-danger mt-3">Crear PDF</button>
                </form>

               



            </div>


        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>