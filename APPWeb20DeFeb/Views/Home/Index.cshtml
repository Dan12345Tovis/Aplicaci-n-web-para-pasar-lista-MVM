@{
    ViewBag.Title = "Home Page";
}

<main>
    <div class="d-flex align-items-center justify-content-center vh-100 bg-light">
        <div class="login-container">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
            </svg>
            <h3>Iniciar Sesión</h3>
            <form  action="/Home/Login" method="post">
                <div class="mb-3">
                    <input style="border: 2px solid red" class="form-control" placeholder="Usuario" required name="Usuario">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="Contraseña" required name="Contraseña" style="border: 2px solid red">
                </div>
                <button type="submit" class="btn btn-danger w-100">Ingresar</button>
            </form>
        </div>
    </div>
</main>